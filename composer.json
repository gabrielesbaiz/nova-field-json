{
    "name": "gabrielesbaiz/nova-field-json",
    "description": "Composable JSON fields and a JSON editor field for Laravel Nova.",
    "keywords": [
        "gabriele sbaiz",
        "laravel",
        "nova",
        "nova-field",
        "json"
    ],
    "homepage": "https://github.com/gabrielesbaiz/nova-field-json",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele@sbaiz.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/nova-devtool": "^1.7",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^9.5|^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\NovaFieldJson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\NovaFieldJson\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\": "workbench/database/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "analyse": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/pest",
        "test-coverage": "@php vendor/bin/pest --coverage --min=90",
        "format": "@php vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\NovaFieldJson\\FieldServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ]
}
